# ─── GitHub Actions Runner ────────────────────────────────────────────────────
GITHUB_ORG=your-org
GITHUB_REPO=stocks-app
RUNNER_TOKEN=<github-runner-registration-token>

# ─── Vault connection ─────────────────────────────────────────────────────────
# All real secrets live INSIDE Vault. Only these two values ever touch GitHub.
VAULT_ADDR=http://vault:8200

# CI pipeline AppRole (store in GitHub Actions Secrets)
VAULT_ROLE_ID=<ci-runner-role-id-from-vault-init.sh>
VAULT_SECRET_ID=<ci-runner-secret-id-from-vault-init.sh>

# App runtime AppRole (store in GitHub Actions Secrets, injected into docker compose)
APP_VAULT_ROLE_ID=<app-runtime-role-id-from-vault-init.sh>
APP_VAULT_SECRET_ID=<app-runtime-secret-id-from-vault-init.sh>

# ─── Vault bootstrap only (not needed after init) ─────────────────────────────
# These are printed by vault/init.sh and then stored IN Vault itself.
# Remove from .env after bootstrap is complete.
# HARBOR_REGISTRY=myregistry.local:5000
# HARBOR_USERNAME=robot$stocks
# HARBOR_PASSWORD=<harbor-robot-account-secret>
# SONAR_TOKEN=<sonarqube-project-analysis-token>
# DB_PASSWORD=<strong-random-password>
